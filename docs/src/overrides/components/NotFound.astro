---
const base = import.meta.env.BASE_URL;
---
<div class="not-found">
  <img id="neko" width="320" height="320" alt="неко" class="pixel" />
  <h1>エラー 404</h1>
  <p class="sub">страница убежала играть с клубком... ня.</p>
  <p class="path">path: <code>{Astro.url.pathname}</code></p>
  <a href={base} class="home">[ вернуться домой ]</a>
</div>

<style>
  .not-found {
    text-align: center;
    padding: 3rem 1rem;
    max-width: 560px;
    margin: 2rem auto;
  }
  .not-found h1 {
    margin-top: 1.5rem;
  }
  .sub {
    font-family: 'DotGothic16', monospace;
    color: #f5c2e7;
    font-size: 1.1rem;
    margin-top: .5rem;
  }
  .path {
    font-family: 'JetBrains Mono', monospace;
    color: #6c7086;
    font-size: .8rem;
    margin-top: 1.5rem;
  }
  .home {
    display: inline-block;
    margin-top: 1.5rem;
    padding: .6rem 1.2rem;
    border: 3px solid #cba6f7;
    color: #89dceb !important;
    font-family: 'Press Start 2P', monospace;
    font-size: .75rem;
    box-shadow: 4px 4px 0 #f5c2e7;
    text-decoration: none;
    transition: transform .1s;
  }
  .home:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #f5c2e7;
  }
  img.pixel {
    image-rendering: pixelated;
    border: 3px solid #f5c2e7;
    box-shadow: 5px 5px 0 #cba6f7;
    background: #313244;
  }
</style>

<script>
  fetch('https://api.waifu.pics/sfw/neko')
    .then(r => r.json())
    .then(d => {
      const img = document.getElementById('neko');
      if (img) img.src = d.url;
    })
    .catch(() => {});
</script>
